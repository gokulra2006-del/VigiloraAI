# ==============================================================================
# VIGILORA AI - Environment Variables
# ==============================================================================

# --- AI & LLM Integrations ---
# Required for Nova AI Assistant, Incident Summarization, and Intent Parsing.
# If omitted, the system falls back to a deterministic safe mode.
ANTHROPIC_API_KEY=

# --- Twilio (SMS & Voice Alerts for SOAR) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# --- Pushover (Push Notifications for SOAR) ---
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# --- Email Alerts (SMTP for SOAR) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO_EMAIL=
