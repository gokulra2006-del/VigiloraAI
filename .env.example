# Backend Configuration
ENVIRONMENT=development
DEBUG=True

# --- Database ---
# Local dev (SQLite — default, no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./sentinelvision.db

# Production (Supabase PostgreSQL):
# Get this from: Supabase Dashboard → Project Settings → Database → URI
# The driver prefix is added automatically — paste the plain postgresql:// URL.
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres

SECRET_KEY=super_secret_key_change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LOG_LEVEL=INFO
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=password123
CORS_ORIGINS=["*"]

# Frontend Configuration
VITE_API_URL=http://localhost:8000
